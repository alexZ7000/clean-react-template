{
    "name": "clean-react-template",
    "private": true,
    "version": "0.0.0",
    "packageManager": "bun@1.4.2",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "bun run typecheck && vite build",
        "typecheck": "tsc --noEmit",
        "lint": "biome check src __tests__ vite.config.ts test-setup.ts",
        "lint:fix": "biome check --write src __tests__ vite.config.ts test-setup.ts",
        "format": "biome format src __tests__ vite.config.ts test-setup.ts",
        "write": "biome format --write src __tests__ vite.config.ts test-setup.ts",
        "preview": "vite preview",
        "test": "bun test",
        "audit": "bun audit",
        "prepare": "husky"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.8",
        "@happy-dom/global-registrator": "^21.0.4",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/bun": "^1.4.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "happy-dom": "^21.0.4",
        "husky": "^9.1.7",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.8"
    }
}
